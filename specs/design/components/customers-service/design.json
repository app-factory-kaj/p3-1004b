{
  "name": "customers-service",
  "type": "service",
  "version": "0.1.0",
  "language": "Go",
  "buildpack": "docker",
  "appPath": "customers-service",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    3,
    4,
    5
  ],
  "description": "Owns each signed-in Shopper's account profile and shipping addresses, backed by an in-memory store with no database. Every operation is scoped to the caller's own profile and addresses under /me — there is no every-row view, since this is personal account data. Does not handle sign-in itself; that is Thunder's job.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "p3-1004b-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "go",
    "thunder-authentication",
    "api-management"
  ]
}
